{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "trailingSlash": false,
  "redirects": [
    { "source": "/json-diff", "destination": "/", "permanent": true },
    { "source": "/xml", "destination": "/xml-diff", "permanent": true },
    { "source": "/json", "destination": "/", "permanent": true },
    { "source": "/sql", "destination": "/sql-diff", "permanent": true },
    { "source": "/text", "destination": "/text-diff", "permanent": true }
  ],
  "rewrites": [
    { "source": "/xml-diff", "destination": "/xml-diff/index.html" },
    { "source": "/sql-diff", "destination": "/sql-diff/index.html" },
    { "source": "/text-diff", "destination": "/text-diff/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
